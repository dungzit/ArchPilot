{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archpilot.internal/contracts/catalog/components.schema.json",
  "title": "ArchPilot logical component catalogue",
  "version": "1.0.0",
  "description": "Shape of contracts/catalog/components.json (design-v2 4.3.1, task 0.6). Validated by backend/app/catalog.py at start-up (the app refuses to start on a malformed catalogue) and by both test suites. Cross-reference rules that JSON Schema cannot express (unique ids, a layer that exists, a nest rule per role, aliases that point at real roles, the neutrality token scan) are asserted by backend/tests/test_catalog.py and src/domain/graph/catalog.test.ts.",
  "type": "object",
  "required": ["catalog", "version", "limits", "layers", "attributes", "sizeClasses", "edgeModes", "roles", "nestRules", "legacyTypes", "aliases"],
  "properties": {
    "$schema": { "type": "string" },
    "catalog": { "const": "archpilot-components" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "limits": {
      "type": "object",
      "required": ["maxNestingDepth"],
      "properties": { "maxNestingDepth": { "type": "integer", "minimum": 1, "maximum": 12 } },
      "additionalProperties": false
    },
    "layers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/snakeId" },
          "order": { "type": "integer", "minimum": 1 },
          "label": { "$ref": "#/$defs/bilingual" }
        },
        "additionalProperties": false
      }
    },
    "attributes": { "type": "array", "items": { "$ref": "#/$defs/fieldDescriptor" } },
    "sizeClasses": {
      "type": "object",
      "propertyNames": { "enum": ["XS", "S", "M", "L", "XL"] },
      "additionalProperties": {
        "type": "object",
        "required": ["vcpu", "memoryGiB"],
        "properties": { "vcpu": { "type": "integer", "minimum": 1 }, "memoryGiB": { "type": "number", "exclusiveMinimum": 0 } },
        "additionalProperties": false
      }
    },
    "edgeModes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": { "id": { "$ref": "#/$defs/snakeId" }, "label": { "$ref": "#/$defs/bilingual" } },
        "additionalProperties": false
      }
    },
    "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" } },
    "nestRules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nestRule" } },
    "legacyTypes": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+\\.[0-9]+$" },
      "additionalProperties": { "$ref": "#/$defs/typeMap" }
    },
    "aliases": { "$ref": "#/$defs/typeMap" }
  },
  "additionalProperties": false,
  "$defs": {
    "snakeId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "camelKey": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,39}$" },
    "bilingual": {
      "type": "object",
      "required": ["en", "vi"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 300 },
        "vi": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "additionalProperties": false
    },
    "fieldDescriptor": {
      "type": "object",
      "required": ["key", "kind", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/camelKey" },
        "kind": { "enum": ["text", "int", "number", "bool", "enum", "list"] },
        "label": { "$ref": "#/$defs/bilingual" },
        "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "maxLength": { "type": "integer", "minimum": 1 },
        "default": { "type": ["string", "number", "boolean"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "required": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["enum", "list"] } } }, "then": { "required": ["values"] } }
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": ["id", "layer", "priority", "label", "purpose", "synonyms", "container", "codeBearing", "defaultAttributes", "accessModes", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/snakeId" },
        "layer": { "$ref": "#/$defs/snakeId" },
        "priority": {
          "description": "The v1 palette priority from requirements-v2.md v2.1 section 4.1.1, copied verbatim so the palette can filter and QA can trace.",
          "enum": ["must", "should", "could"]
        },
        "label": { "$ref": "#/$defs/bilingual" },
        "purpose": { "$ref": "#/$defs/bilingual" },
        "synonyms": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 60 }, "uniqueItems": true },
        "variants": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": { "id": { "$ref": "#/$defs/snakeId" }, "label": { "$ref": "#/$defs/bilingual" } },
            "additionalProperties": false
          }
        },
        "defaultVariant": { "$ref": "#/$defs/snakeId" },
        "container": { "type": "boolean" },
        "codeBearing": { "type": "boolean" },
        "defaultAttributes": {
          "type": "object",
          "properties": {
            "statefulness": { "enum": ["stateless", "stateful"] },
            "tier": { "type": "string" },
            "criticality": { "type": "string" },
            "replicas": { "type": "integer", "minimum": 1 },
            "failureDomainLevel": { "type": "string" }
          },
          "additionalProperties": false
        },
        "accessModes": {
          "type": "object",
          "required": ["asSource", "asTarget"],
          "properties": {
            "asSource": { "type": "array", "items": { "$ref": "#/$defs/snakeId" }, "uniqueItems": true },
            "asTarget": { "type": "array", "items": { "$ref": "#/$defs/snakeId" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/fieldDescriptor" } }
      },
      "additionalProperties": false
    },
    "nestRule": {
      "type": "object",
      "required": ["id", "kind", "roles", "message"],
      "properties": {
        "id": { "type": "string", "pattern": "^NEST-[0-9]{2}$" },
        "kind": { "enum": ["child", "container"] },
        "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/snakeId" }, "uniqueItems": true },
        "parents": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "anyOf": [{ "$ref": "#/$defs/snakeId" }, { "const": "*" }] }
        },
        "accepts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/snakeId" }, "uniqueItems": true },
        "message": { "$ref": "#/$defs/bilingual" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "child" } } }, "then": { "required": ["parents"], "not": { "required": ["accepts"] } } },
        { "if": { "properties": { "kind": { "const": "container" } } }, "then": { "required": ["accepts"], "not": { "required": ["parents"] } } }
      ],
      "additionalProperties": false
    },
    "typeMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/snakeId" },
      "additionalProperties": {
        "type": "object",
        "required": ["role"],
        "properties": { "role": { "$ref": "#/$defs/snakeId" }, "variant": { "$ref": "#/$defs/snakeId" } },
        "additionalProperties": false
      }
    }
  }
}
