# Copy to .env and keep it out of version control (chmod 600 on the Docker host).
# The app reads plain environment variables; .env is loaded by docker compose,
# not by the application itself.

ARCHPILOT_ENV=development
ARCHPILOT_DB_PATH=./data/archpilot.db
ARCHPILOT_BACKUP_DIR=./data/backups

# Vite dev server. In the single-container deployment the SPA is same-origin,
# so set this to an EMPTY value in production (an empty value means "no CORS
# origins", not "use the defaults"). Startup fails if a loopback origin is
# still listed while ARCHPILOT_ENV=production.
ARCHPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ARCHPILOT_SESSION_TTL_HOURS=12
ARCHPILOT_SESSION_COOKIE=archpilot_session
# Double-submit CSRF cookie. Readable by the SPA by design; echoed in the
# x-csrf-token header on every mutating request.
ARCHPILOT_CSRF_COOKIE=archpilot_csrf
# MUST be true anywhere the app is served over HTTPS. Startup fails if
# ARCHPILOT_ENV=production and this is false.
ARCHPILOT_COOKIE_SECURE=false

# Raising this re-hashes each account on its next successful login. Do not
# lower it: stored hashes are only upgraded, never downgraded.
ARCHPILOT_PBKDF2_ITERATIONS=600000
ARCHPILOT_HEALTH_TIMEOUT=2.0
ARCHPILOT_LOG_LEVEL=INFO

# VACUUM INTO snapshot before any pending migration touches an existing
# database. Leave true unless an external process guarantees the backup.
ARCHPILOT_BACKUP_BEFORE_MIGRATE=true

# Used only by scripts/init_db.py --create-user. Never commit a real value.
# ARCHPILOT_ADMIN_PASSWORD=
