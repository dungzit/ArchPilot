# ArchPilot pilot settings. scripts/pilot/start.ps1 copies this file to
# pilot.env (gitignored) the first time. Edit pilot.env, not this file.
# There is no secret in this file: user passwords are generated by
# scripts/pilot/create-users.ps1 and live only in pilot-data/secrets/.
# Do not put quotes around values (docker compose env_file keeps them).

# --- Environment -------------------------------------------------------------
# "pilot" = production-like (single process, no reload) but allowed to run over
# plain HTTP. Do NOT set "production" here: the app then requires
# ARCHPILOT_COOKIE_SECURE=true and refuses to start without it.
# Side effect of any non-production value: the Swagger UI /api/docs and
# /api/openapi.json are served (login is still required for all data routes).
ARCHPILOT_ENV=pilot

# Plain HTTP on the LAN: the session and CSRF cookies must NOT be "Secure",
# otherwise browsers drop them and login looks successful but never sticks.
# Switch to true only after TLS is in front of the app (and ENV may then be
# "production").
ARCHPILOT_COOKIE_SECURE=false

# Same-origin container: no CORS origins. An empty value means "none".
ARCHPILOT_CORS_ORIGINS=

# --- Paths inside the container (host side: ./pilot-data) ---------------------
ARCHPILOT_DB_PATH=/data/archpilot.db
ARCHPILOT_BACKUP_DIR=/data/backups
# SysDesAi reference snapshot. Loaded automatically at startup when the file
# exists; written by scripts/pilot/crawl-reference.ps1.
ARCHPILOT_REFERENCE_SNAPSHOT=/data/reference/sysdesai-snapshot.jsonl.gz

# --- Behaviour ----------------------------------------------------------------
# Session lifetime in hours (default 12 = one working day).
ARCHPILOT_SESSION_TTL_HOURS=12
ARCHPILOT_LOG_LEVEL=INFO
# Snapshot the database before applying a new migration at startup.
ARCHPILOT_BACKUP_BEFORE_MIGRATE=true

# --- Docker / host ------------------------------------------------------------
# Host port. Users open http://<this-pc-ip>:<port>/ . The container always
# listens on 8000 internally.
ARCHPILOT_PILOT_PORT=8000
