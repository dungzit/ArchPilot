data "aws_iam_policy_document" "orders_api_assume" {
  statement {
    sid     = "EcsTasksAssumeRole"
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["ecs-tasks.amazonaws.com"]
    }
  }
}

# Execution role: pull the image, write logs, read linked database secrets. No task role: no access edge needs one.
resource "aws_iam_role" "orders_api_exec" {
  name               = trimsuffix(substr("${local.name_prefix}-orders-api-exec", 0, 64), "-")
  assume_role_policy = data.aws_iam_policy_document.orders_api_assume.json

  tags = {
    Name           = "${local.name_prefix}-orders-api-exec"
    archpilot_node = "orders_api"
  }
}

data "aws_iam_policy_document" "orders_api_exec" {
  statement {
    sid     = "EcrAuthToken"
    actions = ["ecr:GetAuthorizationToken"]
    # AWS requires "*" for this action.
    resources = ["*"]
  }

  statement {
    sid       = "EcrPull"
    actions   = ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"]
    resources = ["arn:${data.aws_partition.current.partition}:ecr:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:repository/*"]
  }

  statement {
    sid       = "WriteLogs"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${aws_cloudwatch_log_group.orders_api_logs.arn}:*"]
  }

  statement {
    sid       = "ReadOrdersDbSecret"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [aws_db_instance.orders_db.master_user_secret[0].secret_arn]
  }
}

resource "aws_iam_role_policy" "orders_api_exec" {
  name   = "archpilot-execution"
  role   = aws_iam_role.orders_api_exec.id
  policy = data.aws_iam_policy_document.orders_api_exec.json
}

