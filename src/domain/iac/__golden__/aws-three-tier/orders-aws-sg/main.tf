  manage_master_user_password = true
  multi_az                    = var.orders_db_multi_az
  db_subnet_group_name        = aws_db_subnet_group.orders_db_subnets.name
  vpc_security_group_ids      = [aws_security_group.orders_db_sg.id]
  publicly_accessible         = false
  deletion_protection         = var.orders_db_deletion_protection
  backup_retention_period     = var.orders_db_backup_retention_days
  copy_tags_to_snapshot       = true
  skip_final_snapshot         = false
  final_snapshot_identifier   = "${local.name_prefix}-orders-db-final"
  auto_minor_version_upgrade  = true

  tags = {
    Name           = "${local.name_prefix}-orders-db"
    archpilot_node = "orders_db"
  }
}

