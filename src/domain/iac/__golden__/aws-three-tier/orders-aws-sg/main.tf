# Targets: orders_api on port 8080.
resource "aws_lb_target_group" "web_lb_tg" {
  port        = 8080
  protocol    = "HTTP"
  target_type = "ip"
  vpc_id      = aws_vpc.main.id

  health_check {
    path    = "/actuator/health"
    matcher = "200"
  }

  tags = {
    Name           = "${local.name_prefix}-web-lb-tg"
    archpilot_node = "web_lb"
  }
}

resource "aws_lb_listener" "web_lb_https" {
  load_balancer_arn = aws_lb.web_lb.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = var.web_lb_certificate_arn

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.web_lb_tg.arn
  }

  tags = {
    Name           = "${local.name_prefix}-web-lb-https"
    archpilot_node = "web_lb"
  }
}

# HTTP only redirects to HTTPS.
resource "aws_lb_listener" "web_lb_http" {
  load_balancer_arn = aws_lb.web_lb.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type = "redirect"

    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }

  tags = {
    Name           = "${local.name_prefix}-web-lb-http"
    archpilot_node = "web_lb"
  }
}

