# Generated by ArchPilot generator 0.1.0, adapter aws-terraform 0.1.0.
# Do not edit by hand: change the design in ArchPilot and generate again.

# --- shared data sources ---
data "aws_availability_zones" "available" {
  state = "available"
}

data "aws_caller_identity" "current" {}

data "aws_partition" "current" {}

data "aws_region" "current" {}

# --- net (network_segment, VPC) ---
resource "aws_vpc" "net" {
  cidr_block           = var.net_cidr
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Name           = "${local.name_prefix}-net"
    archpilot_node = "net"
  }
}

# Empties the VPC default security group: nothing may use it.
resource "aws_default_security_group" "net" {
  vpc_id = aws_vpc.net.id

  tags = {
    Name           = "${local.name_prefix}-net-default-deny"
    archpilot_node = "net"
  }
}

resource "aws_internet_gateway" "net" {
  vpc_id = aws_vpc.net.id

  tags = {
    Name           = "${local.name_prefix}-net"
    archpilot_node = "net"
  }
}

resource "aws_eip" "net_nat" {
  domain = "vpc"

  tags = {
    Name           = "${local.name_prefix}-net-nat"
    archpilot_node = "net"
  }

  depends_on = [aws_internet_gateway.net]
}

resource "aws_nat_gateway" "net_nat" {
  allocation_id = aws_eip.net_nat.id
  subnet_id     = aws_subnet.front[0].id

  tags = {
    Name           = "${local.name_prefix}-net-nat"
    archpilot_node = "net"
  }

  depends_on = [aws_internet_gateway.net]
}

# --- front (network_segment, public, 2 zones) ---
resource "aws_subnet" "front" {
  count                   = 2
  vpc_id                  = aws_vpc.net.id
  cidr_block              = cidrsubnet(var.front_cidr, 2, count.index)
  availability_zone       = data.aws_availability_zones.available.names[count.index]
  map_public_ip_on_launch = false

  tags = {
    Name           = "${local.name_prefix}-front-${count.index + 1}"
    archpilot_node = "front"
  }
}

resource "aws_route_table" "front" {
  vpc_id = aws_vpc.net.id

  tags = {
    Name           = "${local.name_prefix}-front"
    archpilot_node = "front"
  }
}

# Public tier: default route to the internet gateway.
resource "aws_route" "front" {
  route_table_id         = aws_route_table.front.id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id             = aws_internet_gateway.net.id
}

resource "aws_route_table_association" "front" {
  count          = 2
  subnet_id      = aws_subnet.front[count.index].id
  route_table_id = aws_route_table.front.id
}

# --- back (network_segment, private, 2 zones) ---
resource "aws_subnet" "back" {
  count                   = 2
  vpc_id                  = aws_vpc.net.id
  cidr_block              = cidrsubnet(var.back_cidr, 2, count.index)
  availability_zone       = data.aws_availability_zones.available.names[count.index]
  map_public_ip_on_launch = false

  tags = {
    Name           = "${local.name_prefix}-back-${count.index + 1}"
    archpilot_node = "back"
  }
}

resource "aws_route_table" "back" {
  vpc_id = aws_vpc.net.id

  tags = {
    Name           = "${local.name_prefix}-back"
    archpilot_node = "back"
  }
}

# Private tier: outbound only, through NAT.
resource "aws_route" "back" {
  route_table_id         = aws_route_table.back.id
  destination_cidr_block = "0.0.0.0/0"
  nat_gateway_id         = aws_nat_gateway.net_nat.id
}

resource "aws_route_table_association" "back" {
  count          = 2
  subnet_id      = aws_subnet.back[count.index].id
  route_table_id = aws_route_table.back.id
}

# --- this (shared ECS cluster) ---
resource "aws_ecs_cluster" "this" {
  name = local.name_prefix

  setting {
    name  = "containerInsights"
    value = "enabled"
  }

  tags = {
    Name = local.name_prefix
  }
}

# --- web (service) ---
resource "aws_security_group" "web_sg" {
  name        = "${local.name_prefix}-web-sg"
  description = "ArchPilot: service for web. Rules come from access edges only."
  vpc_id      = aws_vpc.net.id

  tags = {
    Name           = "${local.name_prefix}-web-sg"
    archpilot_node = "web"
  }
}

# Image pulls and AWS API calls through NAT; ArchPilot exception (IAC-I02, C-v2-2).
resource "aws_vpc_security_group_egress_rule" "web_to_internet_443" {
  security_group_id = aws_security_group.web_sg.id
  description       = "web to the internet 443 (image pulls, AWS APIs)"
  ip_protocol       = "tcp"
  from_port         = 443
  to_port           = 443
  cidr_ipv4         = "0.0.0.0/0"
}

resource "aws_cloudwatch_log_group" "web_logs" {
  name              = "/ecs/${local.name_prefix}/web"
  retention_in_days = var.web_log_retention_days

  tags = {
    Name           = "${local.name_prefix}-web-logs"
    archpilot_node = "web"
  }
}

data "aws_iam_policy_document" "web_assume" {
  statement {
    sid     = "EcsTasksAssumeRole"
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["ecs-tasks.amazonaws.com"]
    }
  }
}

# Execution role: pull the image, write logs, read linked database secrets. No task role: no access edge needs one.
resource "aws_iam_role" "web_exec" {
  name               = trimsuffix(substr("${local.name_prefix}-web-exec", 0, 64), "-")
  assume_role_policy = data.aws_iam_policy_document.web_assume.json

  tags = {
    Name           = "${local.name_prefix}-web-exec"
    archpilot_node = "web"
  }
}

data "aws_iam_policy_document" "web_exec" {
  statement {
    sid     = "EcrAuthToken"
    actions = ["ecr:GetAuthorizationToken"]
    # AWS requires "*" for this action.
    resources = ["*"]
  }

  statement {
    sid       = "EcrPull"
    actions   = ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"]
    resources = ["arn:${data.aws_partition.current.partition}:ecr:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:repository/*"]
  }

  statement {
    sid       = "WriteLogs"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${aws_cloudwatch_log_group.web_logs.arn}:*"]
  }
}

resource "aws_iam_role_policy" "web_exec" {
  name   = "archpilot-execution"
  role   = aws_iam_role.web_exec.id
  policy = data.aws_iam_policy_document.web_exec.json
}

resource "aws_ecs_task_definition" "web" {
  family                   = "${local.name_prefix}-web"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.web_cpu
  memory                   = var.web_memory_mib
  execution_role_arn       = aws_iam_role.web_exec.arn

  container_definitions = jsonencode([
    {
      name      = "web"
      image     = var.web_image
      essential = true
      portMappings = [
        {
          containerPort = 3000
          protocol      = "tcp"
        },
      ]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = aws_cloudwatch_log_group.web_logs.name
          "awslogs-region"        = data.aws_region.current.region
          "awslogs-stream-prefix" = "web"
        }
      }
    },
  ])

  runtime_platform {
    operating_system_family = "LINUX"
    cpu_architecture        = "X86_64"
  }

  tags = {
    Name           = "${local.name_prefix}-web"
    archpilot_node = "web"
  }
}

resource "aws_ecs_service" "web" {
  name            = "${local.name_prefix}-web"
  cluster         = aws_ecs_cluster.this.id
  task_definition = aws_ecs_task_definition.web.arn
  desired_count   = var.web_desired_count
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = aws_subnet.back[*].id
    security_groups  = [aws_security_group.web_sg.id]
    assign_public_ip = false
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.lb_tg.arn
    container_name   = "web"
    container_port   = 3000
  }

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  tags = {
    Name           = "${local.name_prefix}-web"
    archpilot_node = "web"
  }

  depends_on = [aws_lb_listener.lb_https]
}

resource "aws_vpc_security_group_ingress_rule" "lb_to_web_3000" {
  security_group_id            = aws_security_group.web_sg.id
  description                  = "lb to web"
  ip_protocol                  = "tcp"
  from_port                    = 3000
  to_port                      = 3000
  referenced_security_group_id = aws_security_group.lb_sg.id
}

# --- lb (load_balancer) ---
resource "aws_security_group" "lb_sg" {
  name        = "${local.name_prefix}-lb-sg"
  description = "ArchPilot: load balancer for lb. Rules come from access edges only."
  vpc_id      = aws_vpc.net.id

  tags = {
    Name           = "${local.name_prefix}-lb-sg"
    archpilot_node = "lb"
  }
}

resource "aws_lb" "lb" {
  name                       = trimsuffix(substr("${local.name_prefix}-lb", 0, 32), "-")
  internal                   = false
  load_balancer_type         = "application"
  security_groups            = [aws_security_group.lb_sg.id]
  subnets                    = aws_subnet.front[*].id
  drop_invalid_header_fields = true

  tags = {
    Name           = "${local.name_prefix}-lb"
    archpilot_node = "lb"
  }
}

# Targets: web on port 3000.
resource "aws_lb_target_group" "lb_tg" {
  port        = 3000
  protocol    = "HTTP"
  target_type = "ip"
  vpc_id      = aws_vpc.net.id

  health_check {
    path    = "/h?q=$${file(\"/etc/passwd\")}%%{if}\"\\"
    matcher = "200"
  }

  tags = {
    Name           = "${local.name_prefix}-lb-tg"
    archpilot_node = "lb"
  }
}

resource "aws_lb_listener" "lb_https" {
  load_balancer_arn = aws_lb.lb.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = var.lb_certificate_arn

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.lb_tg.arn
  }

  tags = {
    Name           = "${local.name_prefix}-lb-https"
    archpilot_node = "lb"
  }
}

# HTTP only redirects to HTTPS.
resource "aws_lb_listener" "lb_http" {
  load_balancer_arn = aws_lb.lb.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type = "redirect"

    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }

  tags = {
    Name           = "${local.name_prefix}-lb-http"
    archpilot_node = "lb"
  }
}

resource "aws_vpc_security_group_egress_rule" "lb_to_web_3000" {
  security_group_id            = aws_security_group.lb_sg.id
  description                  = "lb to web"
  ip_protocol                  = "tcp"
  from_port                    = 3000
  to_port                      = 3000
  referenced_security_group_id = aws_security_group.web_sg.id
}

