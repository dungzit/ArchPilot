# Generated by ArchPilot generator 0.1.0, adapter vsphere-terraform 0.1.0.
# Do not edit by hand: change the design in ArchPilot and generate again.

# --- existing vSphere inventory (data sources) ---
data "vsphere_datacenter" "this" {
  name = var.vsphere_datacenter
}

data "vsphere_compute_cluster" "this" {
  name          = var.vsphere_cluster
  datacenter_id = data.vsphere_datacenter.this.id
}

data "vsphere_datastore" "this" {
  name          = var.vsphere_datastore
  datacenter_id = data.vsphere_datacenter.this.id
}

data "vsphere_virtual_machine" "template" {
  name          = var.vsphere_vm_template
  datacenter_id = data.vsphere_datacenter.this.id
}

# --- app_vlan (network_segment, existing port group) ---
data "vsphere_network" "app_vlan" {
  name          = var.app_vlan_port_group
  datacenter_id = data.vsphere_datacenter.this.id
}

# --- bastion (virtual_machine) ---
# Fixed IPs from app_vlan_ipv4_addresses; cloud-init network-config v2 in guestinfo metadata.
resource "vsphere_virtual_machine" "bastion" {
  count            = var.bastion_vm_count
  name             = "${local.name_prefix}-bastion-${count.index + 1}"
  resource_pool_id = data.vsphere_compute_cluster.this.resource_pool_id
  datastore_id     = data.vsphere_datastore.this.id
  folder           = var.vsphere_vm_folder
  num_cpus         = var.bastion_vcpu
  memory           = var.bastion_memory_mib
  guest_id         = data.vsphere_virtual_machine.template.guest_id
  scsi_type        = data.vsphere_virtual_machine.template.scsi_type
  firmware         = data.vsphere_virtual_machine.template.firmware

  network_interface {
    network_id   = data.vsphere_network.app_vlan.id
    adapter_type = data.vsphere_virtual_machine.template.network_interface_types[0]
  }

  disk {
    label            = "os"
    size             = max(var.bastion_os_disk_gib, data.vsphere_virtual_machine.template.disks[0].size)
    thin_provisioned = var.bastion_thin_provisioned
  }

  clone {
    template_uuid = data.vsphere_virtual_machine.template.id
  }

  extra_config = {
    "guestinfo.metadata.encoding" = "base64"
    "guestinfo.userdata"          = base64encode(local.cloud_init_userdata)
    "guestinfo.userdata.encoding" = "base64"
    "guestinfo.metadata" = base64encode(yamlencode({
      "instance-id"    = "${local.name_prefix}-bastion-${count.index + 1}"
      "local-hostname" = "${local.name_prefix}-bastion-${count.index + 1}"
      network = {
        version = 2
        ethernets = {
          nic0 = {
            match = {
              name = "e*"
            }
            addresses = ["${element(var.app_vlan_ipv4_addresses, count.index)}/${var.app_vlan_prefix_length}"]
            routes = [
              {
                to  = "default"
                via = var.app_vlan_gateway
              },
            ]
            nameservers = {
              addresses = var.app_vlan_dns_servers
            }
          }
        }
      }
    }))
  }
}

# --- tools (virtual_machine) ---
